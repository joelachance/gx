# The site is a static export. Nothing here reaches a server at runtime, so
# every variable is read at build time and there is nothing to keep secret.
#
# Copy to .env.local and fill in what you want to change. All of it is optional;
# each has a working default.

# --- Link overrides -------------------------------------------------------
# All four default to the values in src/lib/site-links.ts.

# Where "Source" and the footer links point. Defaults to the gx repository.
# NEXT_PUBLIC_GITHUB_REPO_URL=https://github.com/satoricorp/gx
# NEXT_PUBLIC_DISCORD_URL=https://discord.gg/your-invite
# NEXT_PUBLIC_TWITTER_URL=https://x.com/satori_corp   # @satori_corp
# The "Say hello" link in the Get Started slide. Defaults to support@.
# NEXT_PUBLIC_FOUNDER_CALL_URL=https://cal.com/your-handle/15min

# --- Analytics ------------------------------------------------------------
# Both are off unless set. gx sends no telemetry from the CLI; these two are
# the site only, and they are easy to leave unset.

# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# NEXT_PUBLIC_POSTHOG_HOST=https://f.gx.run